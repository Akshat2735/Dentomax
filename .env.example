# Copy to .env.local for local development. Never commit real values.

# Supabase (public anon key only; the service-role key must never be in the frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile bot check on the sign-up form (free).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile, then:
#   - put the SITE key here (public, shown in the browser)
#   - put the SECRET key in Supabase: supabase secrets set TURNSTILE_SECRET_KEY=... --project-ref <ref>
# Set BOTH or NEITHER. Site key alone: widget shows but is not enforced.
# Secret alone: nobody can sign up, because the form has no widget to produce a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
